// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique
  passwordHash  String
  personalColor String?
  bodyType      String?
  monthlyBudget Int?
  closetItems   ClosetItem[]
  roadmaps      PurchaseRoadmap[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ClosetItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl   String
  category   String
  color      String
  brand      String?
  memo       String?
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// --- BE2: 구매 로드맵 축 (roadmap) ---

model PurchaseRoadmap {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalBudget Int
  status      String        @default("active") // active | completed | archived
  items       RoadmapItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model RoadmapItem {
  id                   Int             @id @default(autoincrement())
  roadmapId            Int
  roadmap              PurchaseRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  category             String
  itemName             String
  estimatedPriceKrw    Int
  priority             String // "high" | "medium" | "low"
  reason               String
  recommendedColorName String?
  recommendedColorHex  String?
  isPurchased          Boolean         @default(false)
  purchasedAt          DateTime?
  order                Int // 로드맵 내 표시 순서
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([roadmapId])
}
