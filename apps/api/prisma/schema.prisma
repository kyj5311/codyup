// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique
  passwordHash  String
  personalColor String?
  bodyType      String?
  heightCm      Int?
  weightKg      Int?
  monthlyBudget Int?
  closetItems   ClosetItem[]
  roadmaps      PurchaseRoadmap[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ClosetItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl   String
  category   String
  color      String
  brand      String?
  memo       String?
  isFavorite Boolean  @default(false)
  // 체형 반영 코디 추천용 — 상의/하의/아우터에서만 의미 있음(신발/악세서리는 null)
  // 값은 category처럼 자유 문자열이며, 프론트에서 카테고리별로 다른 선택지를 보여줌
  fit        String? // 핏: 슬림/레귤러/오버/루즈
  length     String? // 기장: (상의)크롭/레귤러/롱, (하의)숏/롱, (아우터)숏/미디/롱
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// --- BE2: 구매 로드맵 축 (roadmap) ---

model PurchaseRoadmap {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalBudget Int
  status      String        @default("active") // active | completed | archived
  items       RoadmapItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model RoadmapItem {
  id                   Int             @id @default(autoincrement())
  roadmapId            Int
  roadmap              PurchaseRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  category             String
  itemName             String
  estimatedPriceKrw    Int
  priority             String // "high" | "medium" | "low"
  reason               String
  recommendedColorName String?
  recommendedColorHex  String?
  isPurchased          Boolean         @default(false)
  purchasedAt          DateTime?
  order                Int // 로드맵 내 표시 순서
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([roadmapId])
}
